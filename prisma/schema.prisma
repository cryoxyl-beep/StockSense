generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  INVENTORY_MANAGER
  WAREHOUSE_STAFF
}

enum OperationType {
  RECEIPT
  DELIVERY
  INTERNAL
  ADJUSTMENT
}

enum OperationStatus {
  DRAFT
  WAITING
  READY
  DONE
  CANCELED
}

model User {
  id           String   @id @default(cuid())
  loginId      String   @unique
  email        String   @unique
  name         String?
  passwordHash String
  role         UserRole @default(WAREHOUSE_STAFF)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  operations StockOperation[] @relation("ResponsibleUser")
}

model PasswordResetOtp {
  id        String   @id @default(cuid())
  email     String
  codeHash  String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
}

model Warehouse {
  id        String     @id @default(cuid())
  name      String
  shortCode String     @unique
  address   String?
  locations Location[]
  sequences DocumentSequence[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Location {
  id          String   @id @default(cuid())
  name        String
  shortCode   String
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  stockQuants StockQuant[]
  operationsFrom StockOperation[] @relation("FromLocation")
  operationsTo   StockOperation[] @relation("ToLocation")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([warehouseId, shortCode])
}

model Product {
  id           String   @id @default(cuid())
  name         String
  sku          String   @unique
  categoryId   String?
  category     Category? @relation(fields: [categoryId], references: [id])
  unitOfMeasure String  @default("Unit")
  unitCost     Decimal  @default(0) @db.Decimal(12, 2)
  reorderMin   Int      @default(0)
  stockQuants  StockQuant[]
  lines        StockOperationLine[]
  ledger       StockLedgerEntry[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Contact {
  id         String   @id @default(cuid())
  name       String
  email      String?
  phone      String?
  operations StockOperation[]
  createdAt  DateTime @default(now())
}

model StockQuant {
  id         String   @id @default(cuid())
  productId  String
  locationId String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  onHand     Decimal  @default(0) @db.Decimal(14, 3)
  reserved   Decimal  @default(0) @db.Decimal(14, 3)

  @@unique([productId, locationId])
}

model DocumentSequence {
  id          String        @id @default(cuid())
  warehouseId String
  warehouse   Warehouse     @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  type        OperationType
  lastNumber  Int           @default(0)

  @@unique([warehouseId, type])
}

model StockOperation {
  id            String          @id @default(cuid())
  reference     String          @unique
  type          OperationType
  status        OperationStatus @default(DRAFT)
  contactId     String?
  contact       Contact?        @relation(fields: [contactId], references: [id])
  fromLocationId String?
  fromLocation  Location?       @relation("FromLocation", fields: [fromLocationId], references: [id])
  toLocationId   String?
  toLocation    Location?       @relation("ToLocation", fields: [toLocationId], references: [id])
  scheduleDate  DateTime        @default(now())
  responsibleId String?
  responsible   User?           @relation("ResponsibleUser", fields: [responsibleId], references: [id])
  notes         String?
  lines         StockOperationLine[]
  ledger        StockLedgerEntry[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([type, status])
  @@index([scheduleDate])
}

model StockOperationLine {
  id           String         @id @default(cuid())
  operationId  String
  operation    StockOperation @relation(fields: [operationId], references: [id], onDelete: Cascade)
  productId    String
  product      Product        @relation(fields: [productId], references: [id])
  quantity     Decimal        @db.Decimal(14, 3)
  reservedQty  Decimal        @default(0) @db.Decimal(14, 3)

  @@index([operationId])
}

model StockLedgerEntry {
  id           String         @id @default(cuid())
  operationId  String
  operation    StockOperation @relation(fields: [operationId], references: [id], onDelete: Cascade)
  productId    String
  product      Product        @relation(fields: [productId], references: [id])
  reference    String
  date         DateTime       @default(now())
  contactName  String?
  fromLabel    String?
  toLabel      String?
  quantity     Decimal        @db.Decimal(14, 3)
  direction    String
  status       OperationStatus

  @@index([date])
  @@index([reference])
}
